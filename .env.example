# Copie para .env e preencha. Nunca versione o .env.
PORT=3002
LOG_LEVEL=info

# MongoDB próprio do Execution (Atlas M0). Output do repo DB: execution_mongo_url
# Transações exigem replica set: o docker-compose sobe o mongo com --replSet rs0.
MONGO_URL=mongodb://localhost:27017/execution_db?replicaSet=rs0&directConnection=true

# Mensageria (saga)
RABBITMQ_URL=amqp://oficina:oficina@localhost:5672
RABBITMQ_RETRY_DELAY_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000

# Mesmo JWT_SECRET do OS Service e da Lambda de login
JWT_SECRET=

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false
